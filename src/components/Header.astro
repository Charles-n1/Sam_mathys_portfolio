---
---

<header>
	<nav>
		<a href="#">
			<img class="logo" src="/Logo/Logos blanc/logo-developpe-couche-fixe.png" alt="Logo développé couché" />
		</a>

		<div class="links">
			<a href="#services">Services</a>
			<a href="#a-propos">À propos de moi</a>
			<a href="#contact">Contact</a>
		</div>
	</nav>

	<div class="orange-bar"></div>
</header>

<script>
	const logo = document.querySelector('.logo');

	logo.addEventListener('click', () => {
		logo.src = '/Logo/Logos blanc/logo-developpe-couche.webp?' + Date.now();

		setTimeout(() => {
			logo.src = '/Logo/Logos blanc/logo-developpe-couche-fixe.png';
		}, 2400);
	});
</script>

<style>
	header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 10;
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 80px;
		padding: 3px 30px 3px 0;
		background: #0d0d0dcc;
	}

	img {
		height: 136px;
		margin-left: -25px;
		position: relative;
		top: 7px;
	}

	.links {
		display: flex;
		gap: 31px;
	}

	a {
		font-family: 'Antonio', sans-serif;
		font-size: 36px;
		color: white;
		text-decoration: none;
		transition: color 0.2s;
	}

	a:hover {
		color: #e5322d;
	}

	.orange-bar {
		height: 6px;
		background: #ff8a00cc;
	}
</style>

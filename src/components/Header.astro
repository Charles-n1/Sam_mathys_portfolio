<header>
	<nav>
		<img src="/Logo/Logos blanc/logo-developpemennt_couche.png" alt="Logo développé couché" />

		<div class="links">
			<a href="#services">Services</a>
			<a href="#a-propos">À propos de moi</a>
			<a href="#contact">Contact</a>
		</div>
	</nav>

	<div class="orange-bar"></div>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 10;
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 80px;
		padding: 3px 30px 3px 0;
		background: #0d0d0dcc;
	}

	img {
		height: 136px;
		margin-left: -25px;
		position: relative;
		top: 7px;
	}

	.links {
		display: flex;
		gap: 31px;
	}

	a {
		font-family: 'Anton', sans-serif;
		font-size: 36px;
		color: white;
		text-decoration: none;
		transition: color 0.2s;
	}

	a:hover {
		color: #e5322d;
	}

	.orange-bar {
		height: 6px;
		background: #ff8a00cc;
	}
</style>
